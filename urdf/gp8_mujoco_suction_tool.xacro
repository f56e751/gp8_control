<?xml version="1.0"?>
<robot name="gp8_mujoco_suction_tool" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    RViz description aligned with sim/recycling_mujoco/combined_test.xml.

    MuJoCo:
      link6 -> gripper body:  (0.080, -0.030, -0.030)
      gripper -> grip_site:   (0.245, +0.030, +0.030)
      link6 -> grip_site:     (0.325,  0.000,  0.000)

    motoman_gp8_support URDF:
      link_6_t -> flange:     (0.080,  0.000,  0.000)

    Therefore:
      flange -> suction_tool: (0.245,  0.000,  0.000)

    gp8_control.robots.gp8.forward_kinematics() already returns this TCP/grip_site
    frame, so this URDF is for visualization/frame display only.  Do not add this
    offset again in the kinematic planner.
  -->

  <xacro:include filename="$(find motoman_gp8_support)/urdf/gp8_macro.xacro"/>
  <xacro:motoman_gp8 prefix=""/>

  <material name="suction_tool_red">
    <color rgba="1.0 0.0 0.0 0.95"/>
  </material>

  <link name="suction_tool">
    <!-- Red rod from flange to MuJoCo grip_site/TCP.  The link origin is the TCP,
         so the cylinder is centered halfway back toward flange along -X. -->
    <visual name="flange_to_tcp_rod">
      <origin xyz="-0.1225 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.245"/>
      </geometry>
      <material name="suction_tool_red"/>
    </visual>

    <visual name="tcp_marker">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="suction_tool_red"/>
    </visual>
  </link>

  <joint name="flange-suction_tool" type="fixed">
    <origin xyz="0.245 0 0" rpy="0 0 0"/>
    <parent link="flange"/>
    <child link="suction_tool"/>
  </joint>
</robot>
