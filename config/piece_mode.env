# Piece mode (GP8_MODE=pieces) control settings -- ONE place for the robot and
# the twin / RL env. Read by scripts/cycle_demo.sh (robot) and by
# cycle_throw/piece_settings.py (twin, rl/piece_env.py, tools/piece_twin.py).
# A value already set in the shell or the robot PC's .env wins.
#
# Not here, on purpose:
#  * site calibration of the robot PC (.env): GP8_CYCLE_TOP_Z (object top on the
#    real belt), GP8_PUSH_HEIGHT (paddle on the real belt), GP8_CAM_SIGN_CX/CY;
#    the twin derives its own from its geometry (its belt sits ~5 cm higher);
#  * the suction valve delay: cycle_throw/runner.py VALVE_S (the robot fires
#    OFF that early; the twin's valve releases that late).

# push intercept / backswing reach in piece mode [m] (skills mode keeps 0.65)
GP8_PUSH_MAX_REACH=0.70
# push run-up acceleration [m/s^2]
GP8_PUSH_ACCEL=24
