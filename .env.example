# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed as a template.

# Camera PC's HTTP NDJSON detection stream (public IP — do NOT commit the
# real address). NDJSON, one detection record per line.
GP8_PERCEPTION_URL=http://<camera-pc-ip>:8080/detections/stream

# Optional overrides:
# GP8_VENV_PYTHON=/custom/path/.venv/bin/python
